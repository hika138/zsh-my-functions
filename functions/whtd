# 出力先のディレクトリとファイル名
OUTPUT_DIR="$HOME/ai/copilot/whtd"
OUTPUT_FILE="$OUTPUT_DIR/today.md"
SUMMARY_FILE="$OUTPUT_DIR/summary.md"

# ディレクトリが存在しない場合は作成
mkdir -p "$OUTPUT_DIR"

# ファイルが存在する場合は削除
if [ -f "$OUTPUT_FILE" ]; then
    rm "$OUTPUT_FILE"
fi

# 今日の日付を取得 (ISO 8601形式: YYYY-MM-DD)
TODAY=$(date +%Y-%m-%d)

echo "---" > "$OUTPUT_FILE"
echo "## Today's Pull Requests ($TODAY)" >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"

# ghコマンドでPRを取得
# --author @me: 自分が作成したもの
# --created: 今日作成されたもの
# --json: 必要なフィールドを指定
gh pr list --search "author:@me created:$TODAY" --state all --json title,body,url,comments --template \
'{{range .}}### {{.title}}
**URL:** {{.url}}

**Body:**
{{.body}}

**Comments:**
{{range .comments}}- {{.body}}
{{end}}
---
{{end}}' >> "$OUTPUT_FILE"

echo "完了: $OUTPUT_FILE に書き出しました。"

current_dir=$(pwd)
safe_cd "$OUTPUT_DIR" || return 1;

# copilot cliを使用して、今日のPRの内容を要約
copilot -p "$OUTPUT_FILE を読んで概要を理解してください。レビュワーとの会話や追加の対応等を踏まえて今日の活動を詳細かつ、過不足なく説明してください。長くなっても問題ありません。" --model gpt-4.1 --allow-tool 'shell(gh)' > "$SUMMARY_FILE"
safe_cd "$current_dir" || return 1;
less "$SUMMARY_FILE"