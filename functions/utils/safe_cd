if [[ ! -e "$1" && -n "$1" ]]; then
    echo "Error: Directory '$1' does not exist." >&2
    return 1
fi

if [[ ! -d "$1" && -n "$1" ]]; then
    echo "Error: '$1' is not a directory." >&2
    return 1
fi

if [[ -n "$1" ]]; then
    directory="$1"
else
    directory="$HOME"
fi

cd "$directory" || return 1
